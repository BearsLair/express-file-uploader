<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>File Uploader - File Viewer</title>
  </head>
  <body>
    <h1>Your Files</h1>
    <% if (!user) {%>
      <h2>Must be a user to view files</h2>
      <a href="/">Back to Log In Page</a>
    <% } else { %>
      <h2>Hello, <%= user.username %>!</h2>
      <a href="/log-out">Log Out</a>
      <form action="/upload/null" method="POST" enctype="multipart/form-data">
      <input type="file" name="file" />
      <button type="submit">Submit File</button>
      </form>
      <form>
      <label for="folder">Add Folder</label>
      <input type="text" name="folder" />
      <button type="submit">Add Folder</button>
    </form>
    <% } %>

    <% if (folders.length === 1) { %>
      <p>No folders created yet.</p>
    <% } else {%>
      <% folders.map(folder => { %>
        <% if (folder.name !== "null") { %>
        <p>📁<%= folder.name %> <a href=<%= "/folder/" + folder.name %> >View Folder</a></p>
        <% }}) %>
      <% } %>

    <% if (files.length === 0) { %>
      <p>No Files to display yet.</p>
    <% } else {%>
      <% files.map(file => { %>
        <p>File: <%= file.name %> <a href=<%= "/details/" + file.id %> >Details</a></p>
        <% }) %>
      <% } %>

    
  </body>
</html>

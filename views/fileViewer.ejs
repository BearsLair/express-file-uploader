<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>File Viewer</title>
  </head>
  <body style="height: 100vh; width: 100%; background: #e0e0e0; background: linear-gradient(172deg, rgba(224, 224, 224, 1) 0%, rgba(29, 107, 171, 1) 84%, rgba(45, 97, 140, 1) 94%, rgba(82, 82, 82, 1) 100%);">
    <h1>Home Directory</h1>
    <div style="display: flex; flex-direction: column;">
    <% if (!user) {%>
      <h2>Must be a user to view files</h2>
      <a href="/">Back to Log In Page</a>
    <% } else { %>
      <h2>Hello, <%= user.username %>!</h2>
      <a href="/log-out">Log Out</a>
      <form style="margin-top: 15px;" action="/upload/home" method="POST" enctype="multipart/form-data">
        <p style="margin-bottom: 0;">Add File to Home Directory</p>
        <input type="file" name="file" />
        <button type="submit">Submit File</button>
      </form>
      <%- include("./partials/error.ejs") %>
      <form style="margin-top: 10px;margin-bottom: 15px;" action="/newFolder/home" method="POST">
        <label for="folder">Add Folder to Home Directory</label>
        <input type="text" name="folder" />
        <button type="submit">Add Folder</button>
      </form>
    <% } %>
    <% if (folders.length === 0) { %>
      <p>No folders created yet.</p>
    <% } else {%>
      <% folders.map(folder => { %>
        <a href=<%= "/folder/" + folder.id %> >📁<%= folder.name %> </a>
        <% })} %>
    <% if (files.length === 0) { %>
      <p>No Files to display yet.</p>
    <% } else {%>
      <% files.map(file => { %>
        <a style="margin-left: 10px;" href=<%= "/details/" + file.id %> ><%= file.name %></a>
        <% }) %>
      <% } %>
    </div>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>File Uploader - File Viewer</title>
  </head>
  <body>
    <h1>Your files</h1>
    <% if (!user) {%>
      <h2>Must be a user to view files</h2>
      <a href="/">Back to Log In Page</a>
    <% } else { %>
      <h2>Hello, <%= user.username %>!</h2>
      <a href="/log-out">Log Out</a>
    <% } %>
  </body>
</html>

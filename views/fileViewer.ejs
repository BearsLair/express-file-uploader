<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>File Viewer</title>
  </head>
  <body>
    <h1>Your Files</h1>
    <div style="display: flex; flex-direction: column;">
    <% if (!user) {%>
      <h2>Must be a user to view files</h2>
      <a href="/">Back to Log In Page</a>
    <% } else { %>
      <h2>Hello, <%= user.username %>!</h2>
      <a href="/log-out">Log Out</a>
      <form style="margin-top: 15px;" action="/upload/null" method="POST" enctype="multipart/form-data">
      <input type="file" name="file" />
      <button type="submit">Submit File</button>
      </form>
      <form style="margin-bottom: 15px;" action="/file_view/newFolder" method="POST">
      <label for="folder">Add Folder</label>
      <input type="text" name="folder" />
      <button type="submit">Add Folder</button>
    </form>
    <% } %>
    <% if (folders.length === 1) { %>
      <p>No folders created yet.</p>
    <% } else {%>
      <% folders.map(folder => { %>
        <% if (folder.name !== "null") { %>
        <a href=<%= "/folder/" + folder.id %> >📁<%= folder.name %> </a>
        <% }}) %>
      <% } %>
    <% if (files.length === 0) { %>
      <p>No Files to display yet.</p>
    <% } else {%>
      <% files.map(file => { %>
        <a style="margin-left: 10px;" href=<%= "/details/" + file.id %> ><%= file.name %></a>
        <% }) %>
      <% } %>
    </div>
  </body>
</html>

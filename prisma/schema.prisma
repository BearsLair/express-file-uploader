// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// After updating schema run:
// npx prisma migrate dev --name <name>
// npx prisma generate

// View Database:
// npx prisma studio

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  username String
  password String
  files File[]
  folders Folders[]
}

model File {
  id String @id @default(uuid())
  name String
  publicId String
  url String
  uploadAt DateTime @default(now())
  folder Folders @relation(fields: [folderId], references: [id])
  folderId String
  user User @relation(fields: [userId], references: [id])
  userId String
}

// TODO: Home directory boolean
model Folders {
  id String @id @default(uuid())
  containingFolderId String @default("home")
  name String @default("home")
  contents Json[]
  home Boolean @default(false)
  user User @relation(fields: [userId], references: [id])
  userId String
  folder File[]
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   
  expiresAt   DateTime
}
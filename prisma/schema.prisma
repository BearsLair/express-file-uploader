// After updating schema run:
// npx prisma migrate dev --name <name>
// npx prisma generate

// View Database:
// npx prisma studio

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  username String
  password String
  files File[]
}

model File {
  id String @id @default(uuid())
  name String
  url String
  uploadAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  userId String
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   
  expiresAt   DateTime
}